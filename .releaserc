{
  "branches": [
    "main",
    {
      "name": "dev",
      "prerelease": true
    }
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "releaseRules": [
          { "type": "fix", "release": "patch" },
          { "type": "feat", "release": "minor" },
          { "type": "perf", "release": "patch" },
          { "type": "build", "scope": "Needs bump", "release": "patch" }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "✨ Features", "hidden": false },
            { "type": "perf", "section": "🔧 Improvements", "hidden": false },
            { "type": "fix", "section": "🐛 Bug Fixes", "hidden": false },
            { "type": "build", "hidden": true }
          ]
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
       {
          "prepareCmd": "VERSION=\"${nextRelease.version}\"; VERSION_NAME=\"$(printf '%s' \"$VERSION\" | sed -E 's/^([0-9]+(\\.[0-9]+)*)-.*\\.([0-9]+)$/\\1.\\3/')\"; CURRENT_VERSION_CODE=$(grep -oE 'VERSION_CODE=[0-9]+' versionCode.properties | cut -d'=' -f2); NEW_VERSION_CODE=$((CURRENT_VERSION_CODE + 1)); if [ \"$NEW_VERSION_CODE\" -gt 2100000000 ]; then echo \"versionCode=$NEW_VERSION_CODE exceeds Android maximum 2100000000\" >&2; exit 1; fi; echo \"VERSION_CODE=$NEW_VERSION_CODE\" > versionCode.properties; printf 'version = %s\\n' \"$VERSION_NAME\" > gradle.properties.tmp; printf 'versionCode = %s\\n' \"$NEW_VERSION_CODE\" >> gradle.properties.tmp; grep -vE '^(version|versionCode)[[:space:]]*=' gradle.properties >> gradle.properties.tmp; mv gradle.properties.tmp gradle.properties"
       }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "gradle.properties",
          "versionCode.properties",
          "CHANGELOG.md"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "app/build/outputs/apk/**/*.apk"
          }
        ],
        "successComment": false
      }
    ],
    [
      "@cleyrop-org/semantic-release-backmerge",
      {
        "backmergeBranches": [{"from": "main", "to": "dev"}],
        "clearWorkspace": true,
        "ignorePaths": ["gradle.properties"]
      }
    ]
  ]
}
