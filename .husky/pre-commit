export PATH="$HOME/.local/bin:$PATH"

# Run actionlint on staged workflow files
STAGED_YML=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.github/workflows/.*\.(yml|yaml)$' || true)
if [ -n "$STAGED_YML" ]; then
  actionlint $STAGED_YML || {
    echo "actionlint failed. Fix workflow syntax before committing."
    exit 1
  }
fi

# Run Spotless check on staged Kotlin/Java files if gradlew exists
if [ -f "./gradlew" ]; then
  STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(kt|java)$' || true)
  if [ -n "$STAGED" ]; then
    RATCHET=""
    git rev-parse --verify --quiet HEAD >/dev/null && RATCHET="-PspotlessRatchetFrom=HEAD"
    ./gradlew spotlessCheck --quiet $RATCHET || {
      echo "Format check failed. Run './gradlew spotlessApply' and re-stage."
      exit 1
    }
  fi
fi
