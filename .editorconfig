root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 200

[*.kt]
max_line_length = 200
ktlint_function_naming_ignore_when_annotated_with = Composable,Preview
ktlint_standard_backing_property_naming_enabled = false
ktlint_standard_comment_wrapping_enabled = false
