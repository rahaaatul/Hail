default_platform(:android)

platform :android do
  desc "Validate store metadata"
  lane :metadata_check do
    require_relative "../fastlane/helpers/metadata_validator"
    MetadataValidator.new.validate!
  end

  desc "Build debug APK"
  lane :build_debug do |options|
    gradle(task: options[:pr_number] ? "assemblePr" : "assembleDebug")
    apk_path = BuildHelpers.assert_single_apk(
      "app/build/outputs/apk/#{options[:pr_number] ? 'pr' : 'debug'}",
      "Hail-*-#{options[:pr_number] ? 'pr' : 'debug'}.apk"
    )
    lane_context[:apk_path] = apk_path
    lane_context[:version_name] = `sed -n 's/.*versionName\s*=\s*"\([^"]*\)".*/\1/p' app/build.gradle.kts`.strip
    lane_context[:commit_sha] = `git rev-parse --short HEAD`.strip
  end

  desc "Build PR APK"
  lane :build_pr do |options|
    raise "PR_NUMBER is required" unless options[:pr_number]
    gradle(task: "assemblePr")
    apk_path = BuildHelpers.assert_single_apk("app/build/outputs/apk/pr", "Hail-*-pr.apk")
    lane_context[:apk_path] = apk_path
  end

  desc "Build signed release APK"
  lane :build_release do |options|
    release_type = options[:release_type] || "release"
    gradle(task: "assembleRelease")
    apk_path = BuildHelpers.assert_single_apk("app/build/outputs/apk/release", "Hail-v*-*.apk")
    lane_context[:apk_path] = apk_path
    lane_context[:version_name] = `sed -n 's/.*versionName\s*=\s*"\([^"]*\)".*/\1/p' app/build.gradle.kts`.strip
  end

  desc "Create or update GitHub Release"
  lane :github_release do |options|
    GithubReleaseHelper.publish(
      tag: options[:tag],
      repository: options[:repository],
      api_token: options[:api_token],
      name: options[:name],
      description: options[:description],
      asset_path: options[:asset_path],
      prerelease: options[:prerelease] || false
    )
  end

  desc "Send Telegram notification"
  lane :telegram_notify do |options|
    sh("bash .github/scripts/tg_body.sh")
    TelegramHelper.notify(
      artifact: options[:artifact],
      build_type: options[:build_type],
      pr_number: options[:pr_number],
      caption: options[:caption] || "",
      token: ENV["TG_TOKEN"],
      group: ENV["TG_GROUP"],
      topic: TelegramHelper.topic_for(options[:build_type], options[:pr_number])
    )
  end

  desc "Full release orchestration"
  lane :release do |options|
    build_type = options[:build_type] || "release"
    raise "build_type is required" unless build_type
    version_name = `sed -n 's/.*versionName\s*=\s*"\([^"]*\)".*/\1/p' app/build.gradle.kts`.strip
    changelog = File.read("CHANGELOG.md")
    raise "CHANGELOG.md missing version #{version_name}" unless changelog.include?("## [#{version_name}]")
    metadata_check
    build_release(release_type: build_type)
    github_release(
      repository: options[:repository],
      api_token: options[:api_token],
      tag: options[:tag],
      name: version_name,
      description: options[:description],
      asset_path: lane_context[:apk_path],
      prerelease: build_type == "pre-release"
    )
    telegram_notify(
      artifact: lane_context[:apk_path],
      build_type: build_type,
      pr_number: options[:pr_number],
      caption: options[:caption] || ""
    ) if options[:notify] != false
  end
end
