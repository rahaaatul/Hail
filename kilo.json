{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "stack-mcp-server": {
      "type": "remote",
      "url": "https://mcp.stackoverflow.com"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    }
  }
}
